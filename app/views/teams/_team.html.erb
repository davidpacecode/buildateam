<div id="<%= dom_id team %>">
  <div class="wa-stack">
    <div class="wa-split" style="max-width: 900px;">
      <% ["pg", "sg", "sf", "pf", "c"].each do |pos| %>
        <wa-card appearance="filled-outlined" style="max-width: 150px;">
          <div class="wa-frame" slot="media">
            <% player = instance_variable_get("@#{pos}_id") %>
            <%= image_tag "headshots/#{Player.find(player).headshot_file_name}", id: pos %>
          </div>
          <div class="wa-stack wa-align-items-center">
            <wa-tooltip for="<%= pos %>"><%= "#{Player.find(player).first_name} #{Player.find(player).last_name}" %></wa-tooltip>
            <div class="wa-cluster">
              <span><strong><%= "Position: " %></strong><%= "#{Player.find(player).position.upcase}" %></span>
            </div>
            <div class="wa-cluster">
              <span><strong><%= "Team: " %></strong><%= "#{Player.find(player).team}" %></span>
            </div>
          </div>
        </wa-card>
      <% end %>
    </div>
  </div>
</div>
