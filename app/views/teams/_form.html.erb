<%= turbo_frame_tag "edit_team_form" do %>
  <%= form_with(model: team) do |form| %>
    <% if team.errors.any? %>
      <div style="color: red">
        <h2><%= pluralize(team.errors.count, "error") %> prohibited this team from being saved:</h2>

        <ul>
          <% team.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="wa-stack">
      <wa-radio-group name="team[position]" required>
        <div class="wa-split" style="max-width: 900px;">
          <% ["pg", "sg", "sf", "pf", "c"].each do |pos| %>
            <wa-card appearance="<%= card_appearance(@new_team,team,pos) %>" style="max-width: 150px;">
              <div class="wa-frame" slot="media" style="height: 140px; overflow: hidden;">
                <% player = instance_variable_get("@#{pos}_id") %>
                <%= image_tag "headshots/#{Player.find(player).headshot_file_name}", style: "width: 100%; height: 100%; object-fit: cover; object-position: top;" %>
              </div>
              <div class="wa-stack wa-gap-xs wa-align-items-center" style="min-height: 2rem; justify-content: center;">
                <% if @new_team || team.send("#{pos.downcase}_id") == 0 %>
                  <wa-radio value="<%= pos %>"><%= pos.upcase %></wa-radio>
                <% else %>
                  <wa-icon name="lock" style="color: rgb(10, 67, 168);"></wa-icon>
                <% end %>
              </div>
            </wa-card>
          <% end %>
        </div>
      </wa-radio-group>

      <%= form.hidden_field :pg_id, value: @pg_id %>
      <%= form.hidden_field :sg_id, value: @sg_id %>
      <%= form.hidden_field :sf_id, value: @sf_id %>
      <%= form.hidden_field :pf_id, value: @pf_id %>
      <%= form.hidden_field :c_id, value: @c_id %>

      <div>
        <%= "players on this team are #{@team.players}" %>
      </div>
      <div>
        <%= form.submit "Claim selected player" %>
      </div>
    </div>
  <% end %>
<% end %>

<script>
  const form = document.querySelector('.validation');

  // Handle form submit
  form.addEventListener('submit', event => {
    event.preventDefault();
    alert('All fields are valid!');
  });
</script>
